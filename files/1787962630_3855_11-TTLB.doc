n v\u7873\'3f n\u7871\'3fp s\u7889\'3f}{\f42\insrsid8545579\charrsid8545579 ng v\'e3n minh. Gi\'e1m th}{\f0\insrsid8545579\charrsid8545579 \u7883\'3f t\u7893\'3f ch\u7913\'3fc th\'f4ng b\'e1o ho\u7863\'3fc ph\u7893\'3f bi\u7871\'3fn cho ph\u7841\'3fm nh
\'e2n bi\u7871\'3ft nh\u7919\'3fng v\u7845\'3f}{\f42\insrsid8545579\charrsid8545579 n \'f0}{\f0\insrsid8545579\charrsid8545579 \u7873\'3f v\u7873\'3f th\u7901\'3fi s\u7921\'3f}{\f50\insrsid8545579\charrsid8545579  trong v\'e0 ngo\'e0i n\'fd}{
\f0\insrsid8545579\charrsid8545579 \u7899\'3fc, nh\u7919\'3fng ch\'ednh s\'e1ch, ph\'e1p lu\u7853\'3ft m\u7899\'3fi  m\'e0 ph\u7841\'3fm nh\'e2n c\u7847\'3fn bi\u7871\'3ft.
\par 2. M\u7895\'3fi tu\u7847\'3fn ph\u7841\'3f}{\f50\insrsid8545579\charrsid8545579 m nh\'e2n \'f0\'fd}{\f0\insrsid8545579\charrsid8545579 \u7907\'3fc h\u7885\'3fc t\u7853\'3fp 2 bu\u7893\'3fi, m\u7895\'3fi bu\u7893\'3fi 2 gi\u7901\'3f.
\par }{\f50\insrsid8545579\charrsid8545579 3. Ch\'fd\'f5ng tr}{\f0\insrsid8545579\charrsid8545579 \'ecnh v\'e0 n\u7897\'3fi dung c\u7909\'3f th\u7875\'3f, t\'e0i li\u7879\'3fu gi\'e1o d\u7909\'3fc ph\'e1p lu\u7853\'3ft, gi\'e1o d\u7909\'3fc c\'f4ng d\'e2n, l
\u7883\'3fch s\u7917\'3f d\u7921\'3f}{\f50\insrsid8545579\charrsid8545579 ng n\'fd}{\f0\insrsid8545579\charrsid8545579 \u7899\'3fc v\'e0 gi\u7919\'3f}{\f50\insrsid8545579\charrsid8545579  n\'fd}{\f0\insrsid8545579\charrsid8545579 \u7899\'3fc, n\u7871\'3f
p s\u7889\'3f}{\f42\insrsid8545579\charrsid8545579 ng v\'e3n minh cho ph}{\f0\insrsid8545579\charrsid8545579 \u7841\'3fm nh\'e2n do B\u7897\'3f N\u7897\'3fi v\u7909\'3f, B\u7897\'3f Qu\u7889\'3fc ph\'f2ng quy }{\f42\insrsid8545579\charrsid8545579 \'f0}{
\f0\insrsid8545579\charrsid8545579 \u7883\'3fnh v\'e0 bi\'ean so\u7841\'3fn.
