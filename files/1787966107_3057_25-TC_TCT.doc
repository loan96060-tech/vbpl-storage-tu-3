\'fd}{\f0\insrsid3029970\charrsid3029970 \u7907\'3fc tr\'edch l\u7853\'3fp qu\u7929\'3f.
\par - Ch\u7881\'3f}{\f253\insrsid3029970\charrsid3029970  \'f0\'fd}{\f0\insrsid3029970\charrsid3029970 \u7907\'3fc ph\'e9p tr\'edch tr\'ean s\u7889\'3f ti\u7873\'3f}{\f253\insrsid3029970\charrsid3029970 n thu \'f0\'fd}{\f0\insrsid3029970\charrsid3029970 
\u7907\'3fc v\u7873\'3f: b\'e1n h\'e0ng ho\'e1, tang v\u7853\'3ft b\u7883\'3f t\u7883\'3fch thu, ti\u7873\'3fn ph\u7841\'3ft v\'e0 ti\u7873\'3fn thu\u7871\'3f \u7849\'3fn l\u7853\'3fu ph\'e1t hi\u7879\'3f}{\f245\insrsid3029970\charrsid3029970 n \'f0}{
\f0\insrsid3029970\charrsid3029970 \'e3 th\u7921\'3fc n\u7897\'3fp v\'e0o t\'e0i kho\u7843\'3fn t\u7841\'3fm gi\u7919\'3f c\u7911\'3f}{\f253\insrsid3029970\charrsid3029970 a c\'f5 quan thu}{\f0\insrsid3029970\charrsid3029970 \u7871\'3f ho\u7863\'3f}{
\f253\insrsid3029970\charrsid3029970 c c\'f5 quan h}{\f0\insrsid3029970\charrsid3029970 \u7843\'3fi quan m\u7903\'3f t\u7841\'3fi kho b\u7841\'3f}{\f253\insrsid3029970\charrsid3029970 c, kh\'f4ng \'f0\'fd}{\f0\insrsid3029970\charrsid3029970 \u7907\'3fc tr
\'edch tr\'ean s\u7889\'3f ti\u7873\'3f}{\f253\insrsid3029970\charrsid3029970 n thu \'f0\'fd}{\f0\insrsid3029970\charrsid3029970 \u7907\'3fc v\u7873\'3f n\u7907\'3f}{\f245\insrsid3029970\charrsid3029970  \'f0}{\f0\insrsid3029970\charrsid3029970 \u7885\'3f
ng thu v\'e0 ph\u7841\'3ft v\u7873\'3f n\u7897\'3fp ch\u7853\'3fm ti\u7873\'3fn thu\u7871\'3f}{\f245\insrsid3029970\charrsid3029970  \'f0}{\f0\insrsid3029970\charrsid3029970 \u7875\'3f l\u7853\'3fp qu\u7929\'3f.
\par 2. Ngu\u7891\'3fn tr\'edch l\u7853\'3fp qu\u7929\'3f.
\par }{\f245\insrsid3029970\charrsid3029970 \'d0i}{\f0\insrsid3029970\charrsid3029970 \u7873\'3fu 2 Quy\u7871\'3f}{\f245\insrsid3029970\charrsid3029970 t \'f0}{\f0\insrsid3029970\charrsid3029970 \u7883\'3f}{\f245\insrsid3029970\charrsid3029970 nh 180-TTg quy 
\'f0}{\f0\insrsid3029970\charrsid3029970 \u7883\'3fnh ngu\u7891\'3fn tr\'edch l\u7853\'3fp qu\u7929\'3f l\'e0:
\par a. Tr\'edch 30% t\u7893\'3fng s\u7889\'3f ti\u7873\'3f}{\f253\insrsid3029970\charrsid3029970 n thu \'f0\'fd}{\f0\insrsid3029970\charrsid3029970 \u7907\'3fc v\u7873\'3f b\'e1n h\'e0ng ho\'e1, tang v\u7853\'3ft b\u7883\'3f t\u7883\'3fch thu v\'e0 ti\u7873
\'3fn ph\u7841\'3ft sau khi tr\u7915\'3f}{\f245\insrsid3029970\charrsid3029970  \'f0i c\'e1c chi ph\'ed \'f0i}{\f0\insrsid3029970\charrsid3029970 \u7873\'3fu tra, x\'e1c minh, b\u7889\'3fc d\u7905\'3f, v\u7853\'3fn chuy\u7875\'3fn, b\u7843\'3fo qu\u7843
\'3fn, ki\u7875\'3fm nghi\u7879\'3f}{\f245\insrsid3029970\charrsid3029970 m gi\'e1m \'f0}{\f0\insrsid3029970\charrsid3029970 \u7883\'3fnh h\'e0ng ho\'e1 tang v\u7853\'3ft v\'e0 b\u7891\'3f}{\f253\insrsid3029970\charrsid3029970 i th\'fd}{
\f0\insrsid3029970\charrsid3029970 \u7901\'3fng t\u7893\'3fn th\u7845\'3ft do nguy\'ean nh\'e2n kh\'e1ch quan (n\u7871\'3fu c\'f3).
\par b. Tr\'edch 2% s\u7889\'3f ti\u7873\'3fn thu\u7871\'3f \u7849\'3fn l\u7853\'3f}{\f245\insrsid3029970\charrsid3029970 u \'f0}{\f0\insrsid3029970\charrsid3029970 \'e3 ph\'e1t hi\u7879\'3f}{\f253\insrsid3029970\charrsid3029970 n v\'e0 truy thu \'f0}{
\f0\insrsid3029970\charrsid3029970 \u7889\'3fi v\u7899\'3fi c\'e1c doanh nghi\u7879\'3f}{\f253\insrsid3029970\charrsid3029970 p Nh\'e0 n\'fd}{\f0\insrsid3029970\charrsid3029970 \u7899\'3fc.
\par c. Tr\'edch 5% s\u7889\'3f ti\u7873\'3fn thu\u7871\'3f \u7849\'3fn l\u7853\'3f}{\f245\insrsid3029970\charrsid3029970 u \'f0}{\f0\insrsid3029970\charrsid3029970 \'e3 ph\'e1t hi\u7879\'3f}{\f253\insrsid3029970\charrsid3029970 n v\'e0 truy thu \'f0\'fd}{
\f0\insrsid3029970\charrsid3029970 \u7907\'3f}{\f245\insrsid3029970\charrsid3029970 c \'f0}{\f0\insrsid3029970\charrsid3029970 \u7889\'3fi v\u7899\'3fi c\'e1c doanh nghi\u7879\'3fp v\'e0 h\u7897\'3f kinh doanh kh\'e1c.
\par C\u7909\'3f th\u7875\'3f}{\f253\insrsid3029970\charrsid3029970  nh\'fd sau:
\par }{\f0\insrsid3029970\charrsid3029970 - T\u7893\'3fng s\u7889\'3f ti\u7873\'3f}{\f253\insrsid3029970\charrsid3029970 n thu \'f0\'fd}{\f0\insrsid3029970\charrsid3029970 \u7907\'3fc v\u7873\'3f b\'e1n h\'e0ng ho\'e1, tang v\u7853\'3ft t\u7883\'3f
ch thu, theo quy\u7871\'3f}{\f245\insrsid3029970\charrsid3029970 t \'f0}{\f0\insrsid3029970\charrsid3029970 \u7883\'3fnh c\u7911\'3fa H\u7897\'3f}{\f245\insrsid3029970\charrsid3029970 i \'f0}{\f0\insrsid3029970\charrsid3029970 \u7891\'3fng x\'e9t x\u7917
\'3f, ho\u7863\'3fc c\u7911\'3fa to\'e0 \'e1n.
