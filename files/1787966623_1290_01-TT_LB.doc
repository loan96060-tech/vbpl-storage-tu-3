\f0\insrsid14566910\charrsid14574867 \u7843\'3fn vi\u7879\'3fn tr\u7907\'3f quy\'ean t\u7863\'3fng.
\par 3. B\u7843\'3fo hi\u7875\'3fm y t\u7871\'3f Vi\u7879\'3ft Nam: g\u7891\'3fm c\'e1c kho\u7843\'3fn thu sau:
\par a. Kho\u7843\'3fn 2% do BHYT c\'e1c t\u7881\'3fnh, th\'e0nh ph\u7889\'3f n\u7897\'3f}{\f78\insrsid14566910\charrsid14574867 p l\'ean \'f0\'fd}{\f0\insrsid14566910\charrsid14574867 \u7907\'3fc s\u7917\'3f d\u7909\'3fng:
\par }{\f70\insrsid14566910\charrsid14574867 - 1,5% \'f0}{\f0\insrsid14566910\charrsid14574867 \u7875\'3f l\u7853\'3fp qu\u7929\'3f t\u7853\'3f}{\f78\insrsid14566910\charrsid14574867 p trung d\'e0nh \'f0}{\f0\insrsid14566910\charrsid14574867 \u7875\'3f}{
\f70\insrsid14566910\charrsid14574867  \'f0i}{\f0\insrsid14566910\charrsid14574867 \u7873\'3fu ti\u7871\'3ft cho BHYT c\'e1c t\u7881\'3fnh, th\'e0nh ph\u7889\'3f khi g\u7863\'3fp r\u7911\'3fi ro kh\'e1ch quan }{\f78\insrsid14566910\charrsid14574867 c\'f3
 nguy c\'f5 kh\'f4ng \'f0}{\f0\insrsid14566910\charrsid14574867 \u7843\'3fm b\u7843\'3fo an to\'e0n cho qu\u7929\'3f BHYT (g\u7885\'3fi l\'e0 qu\u7929\'3f d\u7921\'3f ph\'f2ng r\u7911\'3fi ro).
\par - 0,5% chi qu\u7843\'3fn l\'fd HCSN b\u7843\'3fo hi\u7875\'3fm y t\u7871\'3f.
\par b. Kho\u7843\'3f}{\f70\insrsid14566910\charrsid14574867 n thu do khai th\'e1c \'f0}{\f0\insrsid14566910\charrsid14574867 \u7889\'3f}{\f78\insrsid14566910\charrsid14574867 i t\'fd}{\f0\insrsid14566910\charrsid14574867 \u7907\'3fng b\u7855\'3ft bu\u7897\'3f
c BHYT Vi\u7879\'3ft Nam tr\u7921\'3fc ti\u7871\'3fp qu\u7843\'3f}{\f70\insrsid14566910\charrsid14574867 n l\'fd (trong \'f0\'f3 d}{\f0\insrsid14566910\charrsid14574867 \'e0nh cho chi ph\'ed kh\'e1m, ch\u7919\'3fa b\u7879\'3fnh 90%, tr\'edch 1,5% cho qu
\u7929\'3f d\u7921\'3f ph\'f2ng r\u7911\'3fi ro c\u7911\'3fa BHYT Vi\u7879\'3ft Nam v\'e0 8,5% cho qu\u7929\'3f qu\u7843\'3fn l\'fd h\'e0nh ch\'ednh s\u7921\'3f nghi\u7879\'3fp).
\par c. C\'e1c kho\u7843\'3fn thu n\'f3i \u7903\'3f}{\f70\insrsid14566910\charrsid14574867  \'f0i}{\f0\insrsid14566910\charrsid14574867 \u7875\'3fm 3 m\u7909\'3f}{\f78\insrsid14566910\charrsid14574867 c I Th\'f4ng t\'fd n\'e0y \'f0\'fd}{
