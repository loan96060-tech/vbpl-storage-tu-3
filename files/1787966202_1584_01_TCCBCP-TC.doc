\f79\cf1\cgrid0\insrsid9335927\charrsid9335927 n nh\'fd sau:
\par }\pard \qc \fi567\li531\ri565\sb120\sl240\slmult0\widctlpar\tx1251\tx1971\tx2691\tx3411\tx4131\tx4851\tx5571\tx6291\tx7011\tx7731\tx8451\tx9171\tx9891\tx10611\tx11331\tx12051\faauto\adjustright\rin565\lin531\itap0 {
\f0\fs24\ul\cf1\cgrid0\insrsid9335927\charrsid9335927 I/ NH\u7918\'3f}{\f71\fs24\ul\cf1\cgrid0\insrsid9335927\charrsid9335927 NG QUY \'d0}{\f0\fs24\ul\cf1\cgrid0\insrsid9335927\charrsid9335927 \u7882\'3fNH CHUNG:
\par }\pard \qj \fi567\li531\ri565\sb120\sl240\slmult0\widctlpar\tx1251\tx1971\tx2691\tx3411\tx4131\tx4851\tx5571\tx6291\tx7011\tx7731\tx8451\tx9171\tx9891\tx10611\tx11331\tx12051\faauto\adjustright\rin565\lin531\itap0 {
\f0\fs24\cf1\cgrid0\insrsid9335927\charrsid9335927 1/ }{\f0\cf1\cgrid0\insrsid9335927\charrsid9335927 \'a7\'d3 gi\'b6m b\'edt m\'e9t ph\'c7n kh\'e3 kh\'a8n v\'d2 \'ae\'eai s\'e8ng c\'b8n b\'e9 x\'b7 Quy\'d5t \'ae\'denh s\'e8 57/TTG c\'f1a Th\'f1 t\'ad\'ed
ng Ch\'ddnh ph\'f1 quy \'ae\'denh m\'f8c tr\'ee c\'cap th\'aam h\'b5ng th\'b8ng cho c\'b8n b\'e9 x\'b7 thu\'e9c mi\'d2n n\'f3i v\'b5 nh\'f7ng x\'b7 th\'f9c s\'f9 kh\'e3 kh\'a8n m\'b5 t\'f5 tr\'ad\'edc \'ae\'d5n nay m\'f8c sinh ho\'b9t ph\'dd \'ae\'b7 \'ae
\'ad\'eec c\'cap \'eb m\'f8c qu\'b8 th\'cap.
\par 2/ Vi\'d6c quy \'ae\'denh tr\'ee c\'cap th\'aam cho 16 c\'b8n b\'e9 \'aeang c\'abng t\'b8c \'a7\'b6ng, \'aeoang th\'d3, ch\'ddnh quy\'d2n x\'b7 mi\'d2n n\'f3i v\'b5 x\'b7 c\'e3 kh\'e3 kh\'a8n l\'b5 nh\'bbm ki\'d6n to\'b5n ch\'ddnh quy\'d2n c\'cap x\'b7 ng
\'b5y m\'e9t v\'f7ng m\'b9nh v\'b5 ho\'b9t \'ae\'e9ng c\'e3 hi\'d6u qu\'b6, U\'fb ban Nh\'a9n d\'a9n c\'b8c \'ae\'dea ph\'ad\'acng c\'c7n ch\'f1 \'ae\'e9ng ch\'d8 \'ae\'b9o s\'bep x\'d5p l\'b9i b\'e9 m\'b8y ch\'ddnh quy\'d2n x\'b7 g\'e4n nh\'d1, th\'f9
c hi\'d6n t\'e8t ch\'f8c n\'a8ng nhi\'d6m v\'f4 qu\'b6n l\'fd Nh\'b5 n\'ad\'edc \'eb c\'ac s\'eb. Tuy\'d6t \'ae\'e8i kh\'abng l\'cay kho\'b6n tr\'ee c\'cap th\'aam \'ae\'d3 chia \'ae\'d2u cho s\'e8 c\'b8n b\'e9 x\'b7 hi\'d6n c\'e3, ng\'b5nh T\'b5i ch\'dd
nh ch\'d8 tr\'ee c\'cap th\'aam cho t\'f5ng c\'b8n b\'e9 theo t\'aan v\'b5 ch\'f8c danh c\'f4 th\'d3 nh\'adng kh\'abng qu\'b8 16 ng\'ad\'eai.
\par }\pard \qc \fi567\li531\ri565\sb120\sl240\slmult0\widctlpar\tx1251\tx1971\tx2691\tx3411\tx4131\tx4851\tx5571\tx6291\tx7011\tx7731\tx8451\tx9171\tx9891\tx10611\tx11331\tx12051\faauto\adjustright\rin565\lin531\itap0 {
\f71\fs24\ul\cf1\cgrid0\insrsid9335927\charrsid9335927 II/ \'d0I}{\f0\fs24\ul\cf1\cgrid0\insrsid9335927\charrsid9335927 \u7872\'3fU KI\u7878\'3fN C\'c1C X\'c3, C\'c1C }{\f71\fs24\ul\cf1\cgrid0\insrsid9335927\charrsid9335927 \'d0}{
\f0\fs24\ul\cf1\cgrid0\insrsid9335927\charrsid9335927 \u7888\'3f}{\f79\fs24\ul\cf1\cgrid0\insrsid9335927\charrsid9335927 I T\'dd}{\f0\fs24\ul\cf1\cgrid0\insrsid9335927\charrsid9335927 \u7906\'3f}{\f79\fs24\ul\cf1\cgrid0\insrsid9335927\charrsid9335927 NG 
\'d0\'dd}{\f0\fs24\ul\cf1\cgrid0\insrsid9335927\charrsid9335927 \u7906\'3f}{\f79\fs24\ul\cf1\cgrid0\insrsid9335927\charrsid9335927 C H\'dd}{\f0\fs24\ul\cf1\cgrid0\insrsid9335927\charrsid9335927 \u7902\'3fNG TR\u7906\'3f C\u7844\'3fP
\par  V\'c0 M\u7912\'3fC TR\u7906\'3f C\u7844\'3fP TH\'caM:
\par }\pard \qj \fi567\li531\ri565\sb120\sl240\slmult0\widctlpar\tx1251\tx1971\tx2691\tx3411\tx4131\tx4851\tx5571\tx6291\tx7011\tx7731\tx8451\tx9171\tx9891\tx10611\tx11331\tx12051\faauto\adjustright\rin565\lin531\itap0 {
\f0\cf1\cgrid0\insrsid9335927\charrsid9335927 1/ Nh\'f7ng x\'b7 \'ae\'ad\'eec x\'b8c \'ae\'denh xem x\'d0t tr\'ee c\'cap th\'aam cho c\'b8n b\'e9 x\'b7 theo Quy\'d5t \'ae\'denh s\'e8 57/TTg ph\'b6i l\'b5 nh\'f7ng x\'b7:
\par - Nh\'f7ng x\'b7 v\'efng cao bi\'aan gi\'edi ch\'ada th\'f9c hi\'d6n Quy\'d5t \'ae\'denh s\'e8 72/H\'a7BT ng\'b5y 13/3/1990 c\'f1a H\'e9i \'ae\'e5ng B\'e9 tr\'ad\'ebng(nay l\'b5 Ch\'ddnh ph\'f1 )
\par - Nh\'f7ng x\'b7 v\'efng s\'a9u \'ae\'e5ng b\'bbng s\'abng C\'f6u Long c\'e3 nhi\'d2u kh\'e3 kh\'a8n,
\par - Nh\'f5ng x\'b7 mi\'d2n n\'f3i, trung du, \'ae\'e5ng b\'bbng qu\'b8 ngh\'cco v\'b5 \'ae\'b7 khai th\'b8c h\'d5t c\'b8c ngu\'e5n thu giao cho x\'b7 nh\'adng kh\'abng \'ae\'f1 ngu\'e5n chi tr\'b6 ph\'f4 c\'cap sinh ho\'b9t ph\'dd b\'d7nh qu\'a9n chu
ng cho 16 c\'b8n b\'e9 x\'b7 \'aeang l\'b5m vi\'d6c d\'ad\'edi 40.000\'ae/th\'b8ng. (T\'e6ng s\'e8 kinh ph\'dd sinh ho\'b9t ph\'dd trong Ng\'a9n s\'b8ch x\'b7 th\'f9c hi\'d6n trong n\'a8m 1992 chia cho 16 ng\'ad\'eai, chia cho 12 th\'b8ng nh\'e1 h\'ac
n 40.000\'ae/th\'b8ng).
\par 2/ Nh\'f8ng c\'b8n b\'e9 \'ae\'ad\'eec h\'ad\'ebng tr\'ee c\'cap th\'aam theo Quy\'d5t \'ae\'denh s\'e8 57/TTG kh\'abng \'ae\'ad\'eec tr\'ee c\'cap b\'cat c\'f8 m\'e9t kho\'b6n n\'b5o kh\'b8c k\'d3 c\'b6 s\'e8 ti\'d2n tr\'ee c\'cap c\'f1a \'aeia ph\'ad
\'acng.
\par 3/ M\'f8c tr\'ee c\'cap th\'aam h\'b5ng th\'b8ng:
\par a/ \'a7\'e8i v\'edi c\'b8n b\'e9 x\'b7 \'ae\'ad\'acng ch\'f8c.
\par - B\'dd th\'ad \'a7\'b6ng u\'fb, Ch\'f1 t\'dech U\'fb ban nh\'a9n d\'a9n x\'b7 m\'f8c t\'e8i \'aea 60.000\'ae/th\'b8ng \'ae\'b6m b\'b6o m\'f8c sinh ho\'b9t ph\'dd hi\'d6n \'aeang h\'ad\'ebng c\'e9ng v\'edi tr\'ee c\'cap th\'aam kh\'abng qu\'b8 100.000\'ae
/th\'b8ng.
\par - Ph\'e3 b\'dd th\'ad \'a7\'b6ng u\'fb, Ph\'e3 ch\'f1 t\'dech U\'fb ban nh\'a9n d\'a9n x\'b7, Th\'ad k\'fd H\'e9i \'ae\'e5ng nh\'a9n d\'a9n x\'b7, x\'b7 \'ae\'e9i tr\'ad\'ebng m\'f8c tr\'ee c\'cap th\'aam t\'e8i \'aea 50.000\'ae/th\'b8ng \'ae\'b6m b\'b6
o m\'f8c sinh ho\'b9t ph\'dd hi\'d6n \'aeang h\'ad\'ebng c\'e9ng v\'edi tr\'ee c\'cap th\'aam kh\'abng qu\'b8 85.000\'ae/th\'b8ng.
\par - \'a7\'e8i v\'edi c\'b8c ch\'f8c danh kh\'b8c m\'f8c tr\'ee c\'cap th\'aam t\'e8i \'aea 40.000\'ae/th\'b8ng, \'ae\'b6m b\'b6o m\'f8c sinh ho\'b9t ph\'dd hi\'d6n \'aeang h\'ad\'ebng c\'e9ng v\'edi tr\'ee c\'cap th\'aam kh\'abng qu\'b8 70.000\'ae/th\'b8ng.

\par b/ \'a7\'e8i v\'edi c\'b8n b\'e9 x\'b7 gi\'b5 y\'d5u ngh\'d8 vi\'d6c:
\par Nh\'f7ng c\'b8n b\'e9 c\'abng t\'b8c t\'b9i x\'b7 tr\'ad\'edc \'ae\'a9y \'ae\'ad\'eec gi\'b6i quy\'d5t ngh\'d8 vi\'d6c theo Quy\'d5t \'ae\'denh s\'e8 130/CP ng\'b5y 20/6/1975 v\'b5 Quy\'d5t \'ae\'denh s\'e8 111/H\'a7BT ng\'b5y 13/10/1981 c\'f1a H\'e9i 
\'ae\'e5ng B\'e9 tr\'ad\'ebng \'ae\'ad\'eec h\'ad\'ebng tr\'ee c\'cap th\'aam c\'f4 th\'d3 nh\'ad sau:
\par - B\'dd th\'ad , ph\'e3 b\'dd th\'ad \'a7\'b6ng u\'fb x\'b7, Ch\'f1 t\'dech Ph\'e3 ch\'f1 t\'dech U\'fb ban nh\'a9n d\'a9n x\'b7 \'ae\'ad\'eec h\'ad\'ebng m\'f8c ch\'aanh l\'d6ch 30.000\'ae/th\'b8ng tr\'f5 \'aei m\'f8c ph\'f4 c\'cap hi\'d6n \'ae\'ad\'ee
c h\'ad\'ebng h\'b5ng th\'b8ng.
\par - C\'b8c ch\'f8c danh kh\'b8c \'ae\'ad\'eec h\'ad\'ebng m\'f8c ch\'aanh l\'d6ch 20.000\'ae/th\'b8ng tr\'f5 \'aei m\'f8c ph\'f4 c\'cap hi\'d6n \'ae\'ad\'eec h\'ad\'ebng h\'b5ng th\'b8ng.
\par c/ X\'b7 n\'b5o \'ae\'b7 tr\'b6 m\'f8c ph\'f4 c\'cap sinh ho\'b9t ph\'dd v\'b5 m\'f8c ph\'f4 c\'cap  quy \'ae\'denh b\'bbng m\'f8c t\'e8i \'aea n\'e3i tr\'aan, kh\'abng \'ae\'ad\'eec t\'ddnh tr\'ee c\'cap th\'aam.
\par }\pard \qc \fi567\li531\ri565\sb120\sl240\slmult0\widctlpar\tx1251\tx1971\tx2691\tx3411\tx4131\tx4851\tx5571\tx6291\tx7011\tx7731\tx8451\tx9171\tx9891\tx10611\tx11331\tx12051\faauto\adjustright\rin565\lin531\itap0 {
\f0\fs24\ul\cf1\cgrid0\insrsid9335927\charrsid9335927 III/ NGU\u7890\'3fN KINH PH\'cd V\'c0 T\u7892\'3f CH\u7912\'3fC CHI TR\u7842\'3f TR\u7906\'3f C\u7844\'3fP TH\'caM CHO C\'c1N B\u7896\'3f X\'c3:
\par }\pard \qj \fi567\li531\ri565\sb120\sl240\slmult0\widctlpar\tx1251\tx1971\tx2691\tx3411\tx4131\tx4851\tx5571\tx6291\tx7011\tx7731\tx8451\tx9171\tx9891\tx10611\tx11331\tx12051\faauto\adjustright\rin565\lin531\itap0 {
\f0\cf1\cgrid0\insrsid9335927\charrsid9335927 1/ Ngu\'e5n Ng\'a9n s\'b8ch \'ae\'d3 chi tr\'ee c\'cap th\'aam cho c\'b8n b\'e9 x\'b7 mi\'d2n n\'f3i v\'b5 c\'b8c x\'b7 c\'e3 kh\'e3 kh\'a8n.
\par - \'a7\'e8i v\'edi c\'b8c x\'b7 trong \'aei\'d2u ki\'d6n hi\'d6n nay ch\'ada c\'e3 ngu\'e5n \'ae\'d3 chi tr\'ee c\'cap th\'aam, th\'d7 ng\'a9n s\'b8ch huy\'d6n ho\'c6c t\'d8nh tr\'ee c\'cap cho x\'b7 \'ae\'d3 chi tr\'b6 cho c\'b8n b\'e9 x\'b7.
\par - Tr\'ad\'eang h\'eep Ng\'a9n s\'b8ch T\'d8nh, th\'b5nh ph\'e8 (g\'e4i t\'bet l\'b5 T\'d8nh) thu\'e9c di\'d6n ph\'b6i nh\'cbn s\'e8 b\'e6 sung Ng\'a9n s\'b8ch Nh\'b5 n\'ad\'edc t\'ad NSTW, sau khi t\'f9 s\'bep x\'d5p, b\'e8 tr\'dd chi ti\'aau ti\'d5t ki
\'d6m nh\'adng kh\'abng \'ae\'f1 chi tr\'b6 cho kho\'b6n chi tr\'ee c\'cap th\'aam cho c\'b8n b\'e9 x\'b7, U\'fb ban nh\'a9n d\'a9n t\'d8nh l\'b5m vi\'d6c v\'edi B\'e9 T\'b5i ch\'ddnh \'ae\'d3 b\'e6 sung th\'aam tr\'ee c\'cap.
\par - \'a7\'e8i v\'edi c\'b8c t\'d8nh kh\'abng thu\'e9c di\'d6n b\'e6 sung Ng\'a9n s\'b8ch t\'f5 Trung \'ad\'acng, nh\'cat thi\'d5t ph\'b6i b\'e8 tr\'dd gi\'b5nh m\'e9t kho\'b6n \'ae\'d3 th\'f9c hi\'d6n Quy\'d5t \'ae\'denh s\'e8 57/TTg c\'f1a Th\'f1 t\'ad\'ed
ng Ch\'ddnh ph\'f1 .
\par 2/ D\'f9 to\'b8n chi v\'d2 kho\'b6n ph\'f4 c\'cap th\'aam ho c\'b8n b\'e9 x\'b7 mi\'d2n n\'f3i x\'b7 c\'e3 kh\'e3 kh\'a8n \'ae\'ad\'eec l\'cbp theo bi\'d3u s\'e8 1 v\'b5 2 k\'ccm theo Th\'abng t\'ad n\'b5y.
\par - Vi\'d6c x\'d0t duy\'d6t s\'e8 x\'b7 v\'b5 danh s\'b8ch c\'b8n b\'e9 x\'b7 v\'b5 m\'f8c ph\'f4 c\'cap th\'aam do Ch\'f1 t\'dech U\'fb ban nh\'a9n d\'a9n huy\'d6n, \'ae\'d2 ngh\'de (d\'f9a tr\'aan c\'ac s\'eb \'ae\'d2 ngh\'de c\'f1a Ch\'f1 t\'dech U\'fb
 ban nh\'a9n d\'a9n x\'b7), Ch\'f1 t\'dech U\'fb ban nh\'a9n d\'a9n t\'d8nh x\'d0t v\'b5 quy\'d5t \'ae\'denh.
\par - Vi\'d6c x\'d0t m\'f8c tr\'ee c\'cap cho c\'b8c x\'b7 \'ae\'d3 chi ph\'f4 c\'cap th\'aam cho c\'b8n b\'e9 x\'b7 \'ae\'ad\'eec th\'f9c hi\'d6n nh\'ad sau: \'a7\'e8i v\'edi t\'d8nh c\'dfn Ng\'a9n s\'b8ch c\'cap huy\'d6n do Ch\'f1 t\'dech U\'fb ban nh\'a9
n d\'a9n huy\'d6n quy\'d5t \'ae\'denh \'ae\'e8i v\'edi c\'b8c t\'d8nh kh\'abng c\'dfn ng\'a9n s\'b8ch c\'cap huy\'d6n, ph\'dfng T\'b5i ch\'ddnh huy\'d6n c\'a8n c\'f8 v\'b5o d\'f9 to\'b8n c\'f1a c\'b8c x\'b7 \'ae\'d3 ki\'d3m tra t\'e6ng h\'eep tr\'d7nh S
\'eb T\'b5i ch\'ddnh \'ae\'d3 xem x\'d0t v\'b5 Ch\'f1 t\'dech U\'fb ban nh\'a9n d\'a9n t\'d8nh quy\'d5t \'ae\'denh m\'f8c tr\'ee c\'cap cho c\'b8c x\'b7.
\par 3/ Th\'f9c hi\'d6n chi tr\'b6, h\'b9ch to\'b8n v\'b5 quy\'d5t to\'b8n.
\par Kho\'b6n chi tr\'ee c\'cap th\'aam cho c\'b8n b\'e9 x\'b7 \'aeang l\'b5m vi\'d6c v\'b5 c\'b8n b\'e9 x\'b7 gi\'b5 y\'d5u ngh\'d8 vi\'d6c \'ae\'ad\'eec chi tr\'b6 tru\'f9c ti\'d5p cho t\'f5ng c\'b8n b\'e9 x\'b7 h\'b5ng th\'b8ng d\'f9a tr\'aan danh s\'b8ch 
\'ae\'b7 \'ae\'ad\'eec Ch\'f1 t\'dech U\'fb ban nh\'a9n d\'a9n t\'d8nh quy\'d5t \'ae\'denh, \'ae\'ad\'eec \'ae\'a8ng k\'fd t\'b9i ph\'dfng T\'b5i ch\'ddnh huy\'d6n v\'b5 chi nh\'b8nh Kho b\'b9c n\'aci c\'e3 t\'b5i kho\'b6n Ng\'a9n s\'b8ch x\'b7 \'ae\'e3
 giao d\'dech.
\par Tr\'ee c\'cap th\'aam cho c\'b8n b\'e9 x\'b7 c\'f1a th\'b8ng 1 v\'b5 2 n\'a8m 1993, \'ae\'dea ph\'ad\'acng n\'b5o c\'e3 ngu\'e5n ng\'a9n s\'b8ch th\'f9c hi\'d6n chi tr\'b6 h\'d5t m\'e9t l\'c7n trong th\'b8ng 3. \'a7\'e8i v\'edi c\'b8c \'ae\'dea ph\'ad\'ac
ng ng\'a9n s\'b8ch c\'e3 kh\'e3 kh\'a8n c\'c7n b\'e8 tr\'dd chi tr\'b6 h\'d5t cho c\'b8n b\'e9 x\'b7 trong th\'b8ng 4 v\'b5 ch\'cbm nh\'cat l\'b5 th\'b8ng 5/1993.
\par Vi\'d6c h\'b9ch to\'b8n v\'b5 quy\'d5t to\'b8n kho\'b6n tr\'ee c\'cap th\'aam n\'b5y \'ae\'ad\'eec ph\'a9n ra hai lo\'b9i: Lo\'b9i tr\'ee c\'cap th\'aam cho c\'b8n b\'e9 x\'b7 \'ae\'ad\'acng ch\'f8c \'ae\'ad\'eec h\'b9ch to\'b8n v\'b5 quy\'d5t to\'b8n v
\'b5o m\'f4c chi 65 Ng\'a9n s\'b8ch x\'b7; Lo\'b9i tr\'ee c\'cap th\'aam cho c\'b8n b\'e9 x\'b7 gi\'b5 y\'d5u ngh\'d8 vi\'d6c h\'b9ch to\'b8n v\'b5 quy\'d5t to\'b8n v\'b5o m\'f4c chi 90 Ng\'a9n s\'b8ch x\'b7.
\par }\pard \qc \fi567\li531\ri565\sb120\sl240\slmult0\widctlpar\tx1251\tx1971\tx2691\tx3411\tx4131\tx4851\tx5571\tx6291\tx7011\tx7731\tx8451\tx9171\tx9891\tx10611\tx11331\tx12051\faauto\adjustright\rin565\lin531\itap0 {
